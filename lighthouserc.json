{
  "ci": {
    "collect": {
      "startServerCommand": "node --env-file-if-exists=.env .output/server/index.mjs",
      "startServerReadyPattern": "Listening",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/app",
        "http://localhost:3200/sign-in",
        "http://localhost:3200/settings"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/app$",
          "aggregationMethod": "median-run",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 337920
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/$|/(sign-in|settings)$",
          "aggregationMethod": "median-run",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 225280
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
