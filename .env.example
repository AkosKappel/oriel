# Database container (compose.yaml)
DB_PASSWORD=change-me
DB_HOST_PORT=5437

# App
DATABASE_URL=postgres://oriel:change-me@127.0.0.1:5437/oriel
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# PowerSync tokens: generate with `node scripts/generate-sync-keys.mjs >> .env`
SYNC_JWT_PRIVATE_KEY=
PS_JWT_KID=
PS_JWT_PUBLIC_X=

# PowerSync service (compose.yaml, scripts/setup-powersync-db.sh)
PS_ROLE_PASSWORD=change-me-too
PS_STORAGE_PASSWORD=change-me-three
POWERSYNC_HOST_PORT=8086
# The address browsers use to reach the PowerSync service
POWERSYNC_URL=http://localhost:8086

# Optional email (resend.com) for invites. Without a key, emails are printed in the server output.
RESEND_API_KEY=
# EMAIL_FROM=Oriel <noreply@your-verified-domain>

# Optional morning reminders (Web Push): make a key pair once with `npx web-push generate-vapid-keys`.
# Without the keys, Settings does not offer reminders.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
