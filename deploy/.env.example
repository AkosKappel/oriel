# Production settings for ~/deploy/oriel (copied to .env there, chmod 600). Fresh secrets only:
# never the development values.

# Both compose files: the stack and its Tailscale sidecar.
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml

# The image to run: a tag from CI (`sha-` plus the first 7 characters of a green commit on
# main). deploy.sh sets it.
IMAGE_TAG=

# openssl rand -base64 24, each
DB_PASSWORD=
PS_ROLE_PASSWORD=
PS_STORAGE_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://oriel.tailb52c43.ts.net

# Sync tokens: `node scripts/generate-sync-keys.mjs` in the repository prints all three.
SYNC_JWT_PRIVATE_KEY=
PS_JWT_KID=
PS_JWT_PUBLIC_X=

# Email (resend.com) for invites and password resets. Without a verified domain, mail only
# reaches the Resend account's own address.
RESEND_API_KEY=
# EMAIL_FROM=Oriel <noreply@your-verified-domain>

# Host folders and the local port of nginx (127.0.0.1 only; visitors come through the sidecar).
APP_PORT=8087
ACCESS_LOG_DIR=/home/akap/logs/oriel
BACKUP_DIR=/home/akap/backups/oriel
