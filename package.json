{
  "name": "oriel",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "npm run i18n && tsr generate && tsc --noEmit",
    "test": "npm run i18n && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "samples": "node scripts/samples.ts",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@inlang/paraglide-js": "^2.29.3",
    "@powersync/common": "^2.4.0",
    "@powersync/web": "^2.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/powersync-db-collection": "0.2.13",
    "@tanstack/react-db": "0.5.12",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.7.14",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.62.0",
    "markdown-it": "^15.0.3",
    "nitro": "3.0.260903-beta",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.3",
    "@inlang/plugin-message-format": "^4.5.6",
    "@playwright/test": "~1.64.1",
    "@powersync/node": "^1.2.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false
  }
}
